{
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.insertSpaces": true, // true по умолчанию, но кто-то может предпочитать табы (как я раньше),
    "[python]": {
        "editor.detectIndentation": false,
    },
    "editor.rulers": [80, 120], // 80 - желательный максимум, 120 - край (больше нельзя)
}
